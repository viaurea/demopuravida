# Cuenta de servicio de Google (Google Cloud Console → IAM → Service Accounts)
GOOGLE_SERVICE_ACCOUNT_EMAIL=nombre@tu-proyecto.iam.gserviceaccount.com
# Pega la clave privada del JSON de la cuenta de servicio tal cual (con \n literales)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ID del Google Sheet (está en la URL: /spreadsheets/d/ESTE_ID/edit)
GOOGLE_SHEET_ID=1MXO5zUy2n5L4GAg_PG4Nd2aufiGJkXUnuc9K2ppQEjk

# Alertas de caducidad por email (opcional — https://resend.com, plan gratuito)
RESEND_API_KEY=
ALERT_EMAIL_TO=info.viaurea@gmail.com

# Vercel añade esto solo cuando activas Cron Jobs — no hace falta ponerlo a mano
CRON_SECRET=
